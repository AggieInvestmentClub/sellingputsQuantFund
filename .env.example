# Copy this file to .env and fill in your keys. Do not put real keys in this file.
# Make sure to keep your keys LOCAL: .env and lseg-data.config.json are gitignored.
# Never upload them to GitHub (even if you delete them after, they stay in the history).

# --- LSEG Workspace (prices, news, options, IV) ---
# App key from the App Key Generator in Workspace (one per person).
# src/ingest/lseg_client.py reads it from here; if it's empty it falls back
# to lseg-data.config.json. Workspace must be open when running scripts.
LSEG_APP_KEY=

# --- LLM evaluation (is the reaction justified?) ---
# Key from platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- News feed ---
BENZINGA_API_KEY=
NEWSAPI_API_KEY=
FINNHUB_API_KEY=

# --- Market / options data (prices, IV, option chains) ---
# Massive (formerly Polygon), Options Starter plan
# REST API key: massive.com/dashboard/keys
POLYGON_API_KEY=
# Flat files (bulk S3 downloads): S3 Access Key + Secret Key from the same dashboard page.
# These are separate from the REST API key above.
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles
TRADIER_API_KEY=

# --- Broker / execution (paper trading first) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
